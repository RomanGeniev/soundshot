<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SoundShot</AssemblyName>
    <AssemblyTitle>SoundShot</AssemblyTitle>
    <Description>SoundShot</Description>
    <RootNamespace>GraphiteCompanion</RootNamespace>
    <Product>SoundShot</Product>
    <Version>2.2.49</Version>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- small tray app: no background GC thread, give memory back eagerly -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Monitoring\PresentMon.exe" LogicalName="SoundShot.PresentMon" />
    <EmbeddedResource Include="Licenses\*.txt" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>




